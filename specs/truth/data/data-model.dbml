Project "travel_ledger_trip_lifecycle" {
  database_type: "PostgreSQL"
  Note: '''
  個人與 owner 管理旅行分帳的目前完整持久化模型。auth schema 的四張表由固定版本 Better Auth
  及 Drizzle adapter 產生並管理；業務表由應用 migration 管理。業務 UUID 由客戶端
  在建立時提供，owner_id 一律由伺服器驗證後的 session 寫入；所有查詢仍須按 owner 篩選。
  本模型是規劃，不是已執行的 migration；SQL 特有限制見各表 Note 與檔尾註解。
  名稱/項目先依 ECMAScript String.trim() 去首尾空白，再驗證非空。
  created_at 用資料庫時鐘；updated_at 在同一次更新中寫入，兩者皆為 timestamptz。
  count 與清單以同一 SQL 或一致性 snapshot 讀取；聚合值不得轉成浮點金額。
  公平份額由支出金額與分攤成員數重建；淨額與付款安排由目前支出、實際還款及
  歷史結清差額重建，不持久化衍生總額。所有分帳寫入由旅行列鎖及帳務 revision 序列化。
  垃圾桶保留原旅行列與全部子資料；僅 owner 明確確認的整趟永久刪除可使用受控
  immutable trigger DELETE 例外。縮圖只存目前的正規化 WebP，不保存原始照片；
  最小操作收據與 UUID reservation 不保存可復原的旅行、帳務或圖片內容。
  '''
}

Table auth.user {
  id text [pk, not null, note: 'Better Auth 使用者 ID；業務 owner_id 採相同 text 型別']
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null]
  image text [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '''
  Better Auth 核心 user 投影，僅啟用 Google provider，不提供密碼登入或刪除帳號。
  固定 Better Auth/Drizzle 相容版本後，generate 核對四張 auth 表、索引及 snake_case 映射，
  再產生 migration；業務服務不可偽造使用者。業務 owner FK 採 RESTRICT，不能直接刪 auth user。
  正式與隔離測試 DB 使用同一套 migrations；真實 Google 串接另行驗證。
  '''
}

Table auth.session {
  id text [pk, not null]
  user_id text [not null]
  token text [not null, unique, note: '敏感 session token，絕不輸出到業務 API 或日誌']
  expires_at timestamptz [not null]
  ip_address text [null]
  user_agent text [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    user_id [name: 'session_user_id_idx']
  }

  Note: 'Better Auth 核心 session；過期與撤銷由 Better Auth 處理。'
}

Table auth.account {
  id text [pk, not null]
  user_id text [not null]
  account_id text [not null, note: 'Google provider 端穩定識別']
  provider_id text [not null, note: '本版只啟用 Google provider']
  access_token text [null, note: '敏感 OAuth token；是否有值由 provider 決定']
  refresh_token text [null, note: '敏感 OAuth token']
  access_token_expires_at timestamptz [null]
  refresh_token_expires_at timestamptz [null]
  scope text [null]
  id_token text [null, note: '敏感 provider ID token']
  password text [null, note: 'Better Auth 核心 optional 欄位；本版不啟用密碼登入']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (provider_id, account_id) [unique, name: 'account_provider_account_uq']
    user_id [name: 'account_user_id_idx']
  }

  Note: 'Better Auth 核心 account；provider/account 二元組是第三方身分的定位鍵。'
}

Table auth.verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null, note: '敏感暫時驗證資料']
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    identifier [name: 'verification_identifier_idx']
  }

  Note: 'Better Auth 核心 verification，供 OAuth/框架內部驗證流程使用。'
}

Table trips {
  id uuid [pk, not null, note: '客戶端在建立請求產生；全系統唯一']
  owner_id text [not null, note: '取自驗證後 session；不接受客戶端傳入']
  name text [not null, note: '去除前後空白後非空']
  start_date date [null]
  end_date date [null]
  simplify_debts boolean [not null, default: false, note: '只改變衍生付款建議，不改寫帳務來源']
  accounting_revision bigint [not null, default: 0, note: '所有影響分帳來源或建議的寫入後遞增']
  deleted_at timestamptz [null, note: 'NULL 為一般可用；非 NULL 為垃圾桶；復原清為 NULL']
  lifecycle_revision bigint [not null, default: 0, note: '成功移入／復原後遞增；purge 結果版本留在收據']
  thumbnail_revision bigint [not null, default: 0, note: '成功上傳／更換／恢復預設後遞增；與帳務 revision 分離']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (owner_id, id) [unique, name: 'trips_owner_id_id_uq']
    (owner_id, created_at, id) [name: 'trips_owner_created_id_idx']
    (owner_id, deleted_at, created_at, id) [name: 'trips_owner_deleted_created_id_idx']
  }

  Note: '''
  起迄日各自可空；CHECK (start_date IS NULL OR end_date IS NULL OR end_date >= start_date)。
  name 須等於 trim 後值且非空。日期為真實日曆 DATE，不做時區轉換。
  PATCH 在交易中鎖定本人旅行（SELECT FOR UPDATE），合併新舊日期後驗證再更新；
  CHECK 違反（23514）回 400 VALIDATION_ERROR，原資料不變。
  expenseCount 從 expenses 批次計算；列表索引配合 owner、created_at、id，不逐列發 SQL 計數。
  CHECK accounting_revision >= 0、lifecycle_revision >= 0、thumbnail_revision >= 0。
  旅行 owner 是唯一具有讀寫權的登入使用者；
  trip_members 的 owner 成員只是可付款、可分攤的帳務身分，不授予同行者登入權。
  所有影響分帳的寫入先由 session 確認 owner，在 READ COMMITTED 交易中鎖旅行 FOR UPDATE，
  依旅行→子資源的順序驗證 active 狀態與更新後遞增帳務 revision；多查詢結算讀取
  使用 REPEATABLE READ 唯讀快照，在同一快照先驗證 active 再讀子資料。
  一般清單只取 deleted_at IS NULL；垃圾桶清單只取 IS NOT NULL。owner scope 查證
  可讀本人垃圾桶旅行的最小辨識資訊，但普通帳本／子資源一律拒絕其讀寫；
  不得把一般清單未列出或普通帳本不可讀直接視為永久刪除。
  移入／復原鎖本人旅行列、核對 expected lifecycle_revision、翻轉 deleted_at 並遞增
  lifecycle_revision，不重建成員或帳務、不遞增 accounting_revision。thumbnail_revision
  僅縮圖命令變更。圖片在交易外處理；提交時鎖本人旅行列，重驗 active、
  expected lifecycle_revision 與 expected thumbnail_revision，避免處理期間移入再復原
  或另一張圖片已保存時覆寫新意圖。永久刪除只允許垃圾桶旅行；完成時將下一個
  lifecycle_revision 留在同交易操作收據。本版無自動到期清除。
  '''
}

Table trip_id_reservations {
  trip_id uuid [pk, not null, note: '全系統永久保留曾使用旅行 UUID；不保存名稱或帳務']
  owner_id text [not null, note: '原 owner；整趟旅行清除後仍供 owner scoped 查證']
  reserved_at timestamptz [not null]
  purged_at timestamptz [null, note: 'NULL 表示尚未永久清除；清除成功後同交易設定']

  Indexes {
    (owner_id, trip_id) [unique, name: 'trip_id_reservations_owner_trip_uq']
  }

  Note: '''
  migration 先從全部既有 trips 回填，再啟用 trips BEFORE INSERT reservation trigger。
  每次新旅行 INSERT 在同交易先插入 reservation；trip_id 全系統唯一且永不重用，
  reservation 衝突使舊建立操作及跨 owner 重用皆拒絕，回滾時 reservation 也回滾。
  與 trips 無刪除型 FK；整趟 purge 只將 purged_at 從 NULL 改成 DB 時鐘，保留 ID、
  owner 與時間作最小 tombstone。不得以 ON CONFLICT UPDATE 重新啟用或覆蓋舊 ID。
  由 trigger 拒絕 reservation 的 DELETE、owner/trip_id/reserved_at UPDATE；purged_at
  只能在對應 owner/trip 的受控 purge context 由 NULL 一次設定，不能清空或重寫。
  本人查證：若 trips 為 active 或 trash 以 trips.deleted_at 判斷；trip 已無列且本人
  reservation.purged_at 非 NULL 才能判斷曾永久刪除。其他 owner 不得查到此記錄。
  不提供從 reservation 重建旅行或帳務的能力；本版無自動清除此最小識別資訊。
  '''
}

Enum trip_operation_kind {
  move_to_trash
  restore
  purge
  save_thumbnail
  reset_thumbnail
}

Enum trip_operation_result_state {
  active
  trash
  purged
}

Table trip_operation_receipts {
  owner_id text [not null, note: '只由驗證後 session 決定；同 owner 命令 UUID 唯一']
  operation_id uuid [not null, note: '客戶端為原操作產生，重送／查證時重用']
  trip_id uuid [not null, note: '不設 trips FK；purge 後仍可查原結果']
  kind trip_operation_kind [not null]
  request_fingerprint bytea [not null, note: '32 bytes；動作、目標、預期版本與參數摘要，不含原圖 bytes']
  result_state trip_operation_result_state [not null, note: '原操作提交時的結果，非目前旅行狀態']
  result_lifecycle_revision bigint [not null, note: '原操作提交後版本；purge 後仍可查']
  result_thumbnail_revision bigint [not null, note: '原操作提交後縮圖版本']
  result_thumbnail_present boolean [null, note: '圖片命令 true／false；生命週期命令為 NULL']
  created_at timestamptz [not null]

  Indexes {
    (owner_id, operation_id) [pk, name: 'trip_operation_receipts_pk']
    (owner_id, trip_id, created_at, operation_id) [name: 'trip_operation_receipts_owner_trip_created_idx']
  }

  Note: '''
  只保存已完整提交的操作結果；失敗或回滾不留成功收據。CHECK octet_length(request_fingerprint)=32、
  版本非負；kind=save_thumbnail/reset_thumbnail 才可有非 NULL result_thumbnail_present，
  其餘為 NULL。move_to_trash 必為 trash、restore 必為 active、purge 必為 purged；
  thumbnail 命令的 result_state 必為 active。其他請求欄位不持久化為可復原資料。
  各命令在同交易內鎖旅行，鎖取得後重讀 receipt，再核對目前狀態／預期版本、
  修改資料並插入收據；purge 使旅行列消失時，等待競爭交易後須重讀 receipt。
  同 owner+operation_id+相同 fingerprint 重送查原結果，不再執行；同 ID 異內容拒絕。
  過期的新命令拒絕且不得覆蓋較新意圖。若 purge 已提交、旅行列消失，先查同 owner
  收據及 reservation，不能把一般查詢的 404 當原命令成功。收據無 trips FK，
  保證 purge 後仍可查；owner_id 另 FK 到 auth.user 並由所有讀取按 owner 篩選。
  原收據成功後若又有較新命令，應同時回原結果及由 trip／reservation 得到的
  目前狀態，不用原結果覆寫目前狀態。不得存旅行名稱、帳務內容、圖片／原圖 bytes。
  本版不提供操作歷程或自動清收據；索引供 owner＋旅行定位，不是公開事件流。
  收據建立後由 trigger 拒絕 UPDATE／DELETE，防止過期重送失去權威結果；
  唯一鍵在並行同 operation_id 請求中決定一個提交結果，競爭者再讀已提交收據。
  '''
}

Table trip_thumbnails {
  owner_id text [not null]
  trip_id uuid [not null]
  image_webp bytea [not null, note: '只保存目前正規化縮圖；長度 1..524288 bytes']
  width integer [not null, note: '最終 WebP 寬，1..1200 px']
  height integer [not null, note: '最終 WebP 高，1..1200 px']
  updated_at timestamptz [not null]

  Indexes {
    (owner_id, trip_id) [pk, name: 'trip_thumbnails_pk']
  }

  Note: '''
  一趟旅行最多一張目前縮圖；CHECK octet_length(image_webp) BETWEEN 1 AND 524288，
  width/height BETWEEN 1 AND 1200；輸出必為單張 WebP，後端另驗實際內容、方向、
  色彩及無 EXIF/GPS。上傳原檔上限 10485760 bytes、25000000 像素、任一邊
  16384 px；輸入只接受靜態 JPEG/PNG/WebP。這些是請求驗證，原檔不寫入 DB。
  轉碼結果最多 524288 bytes，超過則調低尺寸／品質再檢查。
  列表只取 trips.thumbnail_revision 與是否有縮圖投影，不讀 image_webp；
  受權限保護的圖片讀取依 owner、旅行狀態及目前版本取 bytes。
  新圖以相同主鍵原子取代，恢復預設刪除此列並遞增 trips.thumbnail_revision；
  垃圾桶保留本列，復原後仍為原圖；整趟 purge 在同交易刪除本列。
  '''
}

Enum trip_member_role {
  owner
  companion
}

Table trip_members {
  id uuid [pk, not null, note: '穩定帳務識別；改名與停用不改 ID']
  owner_id text [not null]
  trip_id uuid [not null]
  role trip_member_role [not null]
  name text [not null, note: '建立當時的旅行內名稱；Google profile 後續變動不會自動改名']
  name_key text [not null, note: 'generated stored；ASCII A-Z 轉小寫，COLLATE C']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (owner_id, trip_id, id) [unique, name: 'trip_members_owner_trip_id_uq']
    (trip_id, name_key) [unique, name: 'trip_members_trip_name_key_uq']
    (owner_id, trip_id, role) [name: 'trip_members_owner_trip_role_idx']
  }

  Note: '''
  CHECK name = app_trim(name) AND char_length(name) > 0；name_key 與 categories.name_key
  使用同一 generated/ASCII/C collation 策略。唯一鍵不過濾停用成員，owner 也佔用名稱。
  SQL partial UNIQUE (trip_id) WHERE role = 'owner' 保證每趟至多一個 owner；建立旅行及 migration
  在同一交易中建立一個 owner 成員，保證至少一個。owner 成員不得停用或更改 role；
  平常不得刪除，僅 owner 明確確認且旅行已在垃圾桶後，整趟受控 purge 可刪除；
  同行者曾被任何支出、分攤、還款、結清或調整引用時由 FK RESTRICT 禁止實體刪除，改為停用。
  停用者仍參與歷史計算；新支出、新還款及修改支出不得新增停用者引用，重新啟用後可選。
  同行者名稱更改只變顯示名稱，不以名稱建立帳務關聯；不同旅行可重名。
  '''
}

Table categories {
  id uuid [pk, not null, note: '客戶端在建立請求產生；全系統唯一']
  owner_id text [not null]
  name text [not null, note: '已去首尾空白；1 至 30 個 Unicode code points']
  name_key text [not null, note: 'generated stored：只轉 ASCII A-Z 為 a-z；採 C collation 精確比對']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (owner_id, id) [unique, name: 'categories_owner_id_id_uq']
    (owner_id, name_key) [unique, name: 'categories_owner_name_key_uq']
    (owner_id, name, id) [name: 'categories_owner_name_id_idx']
  }

  Note: '''
  本人各旅行共用；name 去首尾空白後以 char_length/JS Array.from 計數，長度 1–30。
  name_key 必須是 GENERATED ALWAYS AS
  (translate(name, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')) STORED，COLLATE "C"。
  僅 ASCII 英文不分大小寫；不合併內部空白、重音或其他 Unicode 字形；不同 owner 可同名。
  CHECK 要求 name 已 trim 且長度合法；同 owner 名稱唯一違反（23505）回 409 CATEGORY_NAME_CONFLICT。
  改名保留 id，支出 JOIN 目前名稱；usageCount 由本人所有旅行的支出引用數計算，不存摘要。
  刪除由 FK RESTRICT 保護競爭；該 FK 違反（23503）回 409 CATEGORY_IN_USE，不能只看舊 usageCount。
  category_id 為 null 時採 MATCH SIMPLE；有值時複合 FK 限制分類必須和支出同 owner。
  '''
}

Table currencies {
  code char(3) [pk, not null, note: 'SIX ISO 4217 三碼']
  name text [not null, note: '英文顯示/搜尋名稱']
  minor_unit smallint [not null, note: '目前可選條目的數字小數位數，0 至 4']
  snapshot_date date [not null, note: '此可選條目所屬的 SIX List One 發布日期']
  is_selectable boolean [not null, note: '退役條目保留外鍵，新的支出不得再選']

  Note: '''
  CHECK：code 為三碼大寫，minor_unit 在 0–4。來源 SIX ISO 4217 List One。
  快照 SHA-256：33139b438657d1cee116ba737807ea71d19d6de4b90f799a09c56f0cc6a1b0ff。
  初始快照 2026-09-17 共 165 個可選代碼；可選列的 snapshot_date 必須一致，否則匯入/啟動驗證失敗。
  更新快照以單一交易封存來源、更新可選條目並將退役代碼標不可選；本版無自動更新工作。
  保留舊代碼外鍵與每筆支出、還款及結清快照的歷史位數，不重解讀舊金額。
  165 列直接掃描，不另加布林索引。
  '''
}

Table expenses {
  id uuid [pk, not null, note: '客戶端在建立請求產生；全系統唯一']
  owner_id text [not null, note: '冗餘於 trip 但用於複合外鍵隔離及查詢']
  trip_id uuid [not null]
  payer_member_id uuid [not null, note: '同旅行成員；付款人可不在分攤集合中']
  category_id uuid [null]
  item text [not null, note: '去除前後空白後非空']
  amount_minor bigint [not null, note: '正整數最小貨幣單位；單筆 <= 9223372036854775807']
  currency_code char(3) [not null]
  minor_unit smallint [not null, note: '此筆金額建立或實際更改幣別時適用的歷史位數']
  spent_on date [not null, note: '日曆日期，可在旅行日期範圍之外']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (owner_id, trip_id, id) [unique, name: 'expenses_owner_trip_id_uq']
    (owner_id, trip_id, spent_on, id) [name: 'expenses_owner_trip_date_id_idx']
    (owner_id, category_id) [name: 'expenses_owner_category_idx']
  }

  Note: '''
  CHECK：amount_minor > 0、minor_unit BETWEEN 0 AND 4、item 已 trim 且非空。
  支出日期可在旅行期間之外。客戶端 UUID 撞 PK 回 409 ID_CONFLICT，不回衝突紀錄。
  寫入時檢查可選幣別及其位數；FK 只保證代碼存在。以 BigInt 解析大單位字串，單筆最多 9223372036854775807 最小單位。
  PATCH 在交易中鎖定本人支出，合併後一次驗證/更新；外鍵為旅行與分類歸屬的最終保護。
  未改幣別時沿用本筆 minor_unit；實際換幣別才使用新快照位數，沒有換匯或靜默四捨五入。
  修改/刪除後直接從目前紀錄計算 count/總額；GROUP BY currency_code,minor_unit 的 SUM(bigint)
  回 NUMERIC 整數字串，後端用 BigInt 升到同幣別最大位數再加總。總額可超過單筆 BIGINT 範圍。
  (owner_id,trip_id,spent_on,id) 支援列表及游標；(owner_id,category_id) 支援使用筆數與刪除 FK 檢查。
  實作後以 EXPLAIN (ANALYZE, BUFFERS) 檢查索引效益，不另建摘要或每欄索引。
  分攤者由 expense_shares 的成員集合表示，每筆支出須至少一人，且不得重複；
  每人份額在同幣別同歷史 minor_unit 下精確為 amount_minor / 分攤者數。
  支出與分攤者集合在同一交易中新增或完整取代；刪除支出時僅刪除其分攤關聯。
  修改或刪除支出不刪除已發生的還款、結清及差額調整。
  '''
}

Table expense_shares {
  owner_id text [not null]
  trip_id uuid [not null]
  expense_id uuid [not null]
  member_id uuid [not null]

  Indexes {
    (expense_id, member_id) [pk, name: 'expense_shares_pk']
    (owner_id, trip_id, member_id) [name: 'expense_shares_owner_trip_member_idx']
  }

  Note: '''
  只保存集合，不保存經取整的份額或分數。須以交易及延遲檢查／等價寫入驗證
  保證每筆存活支出至少一名分攤者。payer_member_id 不要求出現在本集合。
  刪除支出時 CASCADE 刪除此集合；刪除成員時 RESTRICT，保護歷史引用。
  '''
}

Enum payment_record_kind {
  independent
  settlement
}

Table settlements {
  id uuid [pk, not null]
  owner_id text [not null]
  trip_id uuid [not null]
  debtor_member_id uuid [not null]
  creditor_member_id uuid [not null]
  currency_code char(3) [not null]
  obligation_numerator numeric [not null, note: '結清當時精確應付額，在 obligation_minor_unit 尺度的整數分子']
  obligation_denominator numeric [not null, note: '正整數分母']
  obligation_minor_unit smallint [not null, note: '精確應付額的歷史尺度']
  arrangement_key text [not null, note: '結清當時的確定性安排識別，包含來源 revision 與模式']
  source_revision bigint [not null, note: '經寫入交易核對過的付款安排來源版本']
  simplify_debts boolean [not null, note: '當時的建議模式，不控制後續重算']
  created_at timestamptz [not null]

  Indexes {
    (owner_id, trip_id, arrangement_key) [unique, name: 'settlements_arrangement_key_uq']
    (owner_id, trip_id, source_revision, debtor_member_id, creditor_member_id, currency_code) [name: 'settlements_source_idx']
    (owner_id, trip_id, id) [unique, name: 'settlements_owner_trip_id_uq']
  }

  Note: '''
  不可變的已結清安排快照；CHECK debtor <> creditor、分子 > 0、分母 > 0 且皆為整數、
  minor_unit BETWEEN 0 AND 4、source_revision >= 0。結清時帶安排識別及 revision，
  旅行列鎖內重算並核對成員、幣別、模式和精確應付額，才建立本列、實付與兩筆調整，
  並遞增旅行 revision。若版本過期，不寫入任何結清資料。快照不因後續支出修正重新套用。
  狀態以此不可變紀錄表示已結清，不能將實付金額與公平應付額差異視為未付或反向債權。
  單筆歷史 UPDATE／DELETE 持續禁止；僅同一已確認垃圾桶旅行的受控整趟 purge 可 DELETE。
  '''
}

Table repayments {
  id uuid [pk, not null, note: '建立前產生的穩定 UUID；回應未明時可查證，避免盲目重送']
  owner_id text [not null]
  trip_id uuid [not null]
  payer_member_id uuid [not null]
  payee_member_id uuid [not null]
  amount_minor bigint [not null, note: '正整數實付金額，為當時幣別最小單位']
  currency_code char(3) [not null]
  minor_unit smallint [not null, note: '實付時採用的幣別位數快照']
  paid_on date [not null]
  kind payment_record_kind [not null]
  settlement_id uuid [null, unique, note: '結清實付必有；獨立部分還款必為 NULL']
  created_at timestamptz [not null]

  Indexes {
    (owner_id, trip_id, id) [unique, name: 'repayments_owner_trip_id_uq']
    (owner_id, trip_id, paid_on, id) [name: 'repayments_owner_trip_date_id_idx']
  }

  Note: '''
  CHECK amount_minor > 0、minor_unit BETWEEN 0 AND 4、payer <> payee，
  kind = settlement 當且僅當 settlement_id 非 NULL。兩端必屬同一旅行且寫入時有效。
  獨立還款可部分還款、多次還款；超過當前應付時，在旅行鎖內重算警告額及反向債權，
  僅在 owner 明確確認相同 revision/結果後保存。獨立超付可產生反向債權。
  結清實付與 settlements 一對一，且兩端、幣別一致；其差額由兩筆調整吸收，
  不按精確應付額自動取整，也不儲存取整選擇。任何還款均作為實際事實保留，
  不因 Simplify Debts 切換或來源支出修改/刪除而改寫。
  單筆歷史 UPDATE／DELETE 持續禁止；僅同一已確認垃圾桶旅行的受控整趟 purge 可 DELETE。
  '''
}

Table settlement_adjustments {
  settlement_id uuid [not null]
  owner_id text [not null]
  trip_id uuid [not null]
  member_id uuid [not null]
  currency_code char(3) [not null]
  numerator numeric [not null, note: '有號整數分子；正數增加該成員淨額']
  denominator numeric [not null, note: '正整數分母']
  minor_unit smallint [not null, note: '差額分數的歷史尺度']

  Indexes {
    (settlement_id, member_id) [pk, name: 'settlement_adjustments_pk']
    (owner_id, trip_id, member_id, currency_code) [name: 'settlement_adjustments_member_currency_idx']
  }

  Note: '''
  每次結清恰有付款人與收款人兩筆不可變調整，與一筆實付原子寫入；
  CHECK 分母 > 0、分子與分母均為整數、minor_unit BETWEEN 0 AND 4。
  將實付轉到 obligation_minor_unit 或更高共同尺度後，付款人的調整 = 精確應付 − 實付；
  收款人的調整 = 實付 − 精確應付，兩筆精確總和為零。若差額為零仍保留兩筆零調整，
  便於稽核一對一完整性。DB deferred constraint trigger／等價交易驗證保證兩筆、
  成員與 settlements 兩端一致、幣別一致及精確相反；不存或推論取整方式。
  單筆歷史 UPDATE／DELETE 持續禁止；僅同一已確認垃圾桶旅行的受控整趟 purge 可 DELETE。
  '''
}

Ref: auth.session.user_id > auth.user.id [delete: cascade]
Ref: auth.account.user_id > auth.user.id [delete: cascade]
Ref: trips.owner_id > auth.user.id [delete: restrict]
Ref: trip_id_reservations.owner_id > auth.user.id [delete: restrict]
Ref: trip_operation_receipts.owner_id > auth.user.id [delete: restrict]
Ref: categories.owner_id > auth.user.id [delete: restrict]
Ref: trip_thumbnails.(owner_id, trip_id) > trips.(owner_id, id) [delete: restrict]
Ref: trip_members.(owner_id, trip_id) > trips.(owner_id, id) [delete: restrict]
Ref: expenses.(owner_id, trip_id) > trips.(owner_id, id) [delete: restrict]
Ref: expenses.(owner_id, category_id) > categories.(owner_id, id) [delete: restrict]
Ref: expenses.(owner_id, trip_id, payer_member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: expenses.currency_code > currencies.code [delete: restrict]
Ref: expense_shares.(owner_id, trip_id, expense_id) > expenses.(owner_id, trip_id, id) [delete: cascade]
Ref: expense_shares.(owner_id, trip_id, member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: settlements.(owner_id, trip_id) > trips.(owner_id, id) [delete: restrict]
Ref: settlements.(owner_id, trip_id, debtor_member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: settlements.(owner_id, trip_id, creditor_member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: settlements.currency_code > currencies.code [delete: restrict]
Ref: repayments.(owner_id, trip_id) > trips.(owner_id, id) [delete: restrict]
Ref: repayments.(owner_id, trip_id, payer_member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: repayments.(owner_id, trip_id, payee_member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: repayments.(owner_id, trip_id, settlement_id) > settlements.(owner_id, trip_id, id) [delete: restrict]
Ref: repayments.currency_code > currencies.code [delete: restrict]
Ref: settlement_adjustments.(owner_id, trip_id, settlement_id) > settlements.(owner_id, trip_id, id) [delete: restrict]
Ref: settlement_adjustments.(owner_id, trip_id, member_id) > trip_members.(owner_id, trip_id, id) [delete: restrict]
Ref: settlement_adjustments.currency_code > currencies.code [delete: restrict]

// Migration 補充（DBML Note 不會自動產生 generated/collation/function DDL）：
// app_trim(text) = btrim(value, U&'\0009\000A\000B\000C\000D\0020\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000\FEFF')。
// 以 IMMUTABLE SQL function 實作；不可只用預設 btrim（只去一般空格）。
// trips.name/expenses.item/trip_members.name：CHECK (value = app_trim(value) AND char_length(value) > 0)。
// categories.name：CHECK (name = app_trim(name) AND char_length(name) BETWEEN 1 AND 30)。
// 新增 migration，不改已套用檔：每趟旅行建立唯一 owner 成員；每筆舊支出回填 owner payer 與唯一 owner share，
// 再補 payer NOT NULL、同旅行複合 FK 與各項約束。原始金額、minor_unit、幣別、日期、分類與統計不變。
// 啟用新程式前完成 migration，並停止舊程式寫入，避免舊版新增支出缺少分攤集合。
// Setup 必須補齊各表 Note 的 CHECK、generated name_key、C collation、partial UNIQUE 與延遲完整性檢查，
// 特別驗證 settlement 與 repayment 一對一、兩筆零和調整及每筆存活支出的非空分攤集合。
// 帳務按 currency_code 先將各歷史 minor_unit 精確升至同幣別共同尺度，再以 BigInt 有理數計算；
// NUMERIC 欄位只存整數分子/分母，不以 SQL 除法持久化有限小數；不同幣別不可相加或抵銷。
// 回歸涵蓋 trim/emoji/ASCII 重名、停用名稱保留、跨 owner/trip FK、分類刪除競爭、
// PATCH 與多幣別精確加總、舊支出回填、結清/還款競態、實付差額及獨立超額反轉。
// 006 新 migration（不回寫既有 0001–0003）：先建 trip_id_reservations 並回填現存 trips，
// 再加 trips INSERT reservation trigger，避免 client UUID 在 purge 後經原建立請求重用；
// reservation 的 PK 由全系統 UUID 衝突保護，trip INSERT 與 reservation 必須同交易。
// reservation 及 receipt 的不可變 trigger 與 purge 一次性標記同 migration 建立。
// 新增 deleted_at、lifecycle_revision、thumbnail_revision，建 owner+deleted_at 清單索引；
// 新增 trip_thumbnails（bytea CHECK 1..524288）、trip_operation_receipts、兩個 operation enums。
// 接收圖片的 10 MiB/25 MP/16384 px 與靜態格式限制由 API 驗證，DB 只保存已轉碼 WebP。
// 所有旅行子資源普通讀寫均先在 owner scoped 一致快照或旅行列鎖內核對 deleted_at IS NULL；
// 垃圾桶查證與復原／purge 使用專屬 owner scope。不得讓普通 404 代表單筆支出刪除成功；
// owner 可藉已存在的 trash 列及 reservation.purged_at 區分 active/trash/purged。
// 同旅行寫入鎖序：先 trips FOR UPDATE，核對狀態和 expected lifecycle/thumbnail revision，
// 鎖後重讀 receipt，再讀／鎖子資料，最後一次提交業務變更與 receipt；
// 同 operation_id 重送比 fingerprint，勿因競爭者最初未讀到收據就錯報版本衝突。
// purge 必須同一 READ COMMITTED 交易內：owner scoped 鎖定 trash trip，驗 expected lifecycle
// revision 並取得 owner_id/trip_id 的 transaction-local purge context；依序刪除
// settlement_adjustments → repayments → settlements → expense_shares → expenses → trip_members
// → trip_thumbnails → trips；再更新 reservation.purged_at 及寫 purge receipt，一起 COMMIT。
// 若任一步失敗則全回滾，包括 reservation/receipt；沒有部分清除或已成功的假回應。
// 修改既有 app_protect_owner 與 app_immutable_payment trigger：只在 TG_OP='DELETE'、
// OLD.owner_id/trip_id 完全吻合 transaction-local purge context，且該 trip 仍在垃圾桶
// 時放行；UPDATE 與其他單筆 DELETE 一律按原規則拒絕。context 只在專用 purge routine
// 交易範圍內設置與清理，不採 session_replication_role 或全域 DISABLE TRIGGER。
// 上述 context 為 app 既有 DB 權限內的操作限制，不聲稱能隔離任意 SQL 權限持有者。
// 既有 deferred checks 對已被同交易整趟清除的 trips/expenses/settlements 跳過；
// purge migration 必須以有完整支出、分攤、還款、結清、調整、owner 及自訂圖的旅行
// 證明提交成功，且單筆歷史刪除仍拒絕。共用分類與幣別／帳號不進 purge；
// 垃圾桶支出仍計入 categories.usageCount 並由分類 FK RESTRICT 保護復原連結。
// 操作收據僅保存已提交結果。purge 後 trip FK 不能存在，故 receipt.trip_id 刻意無 FK；
// receipt.owner_id 與 reservation.owner_id 仍 FK auth.user，查證必須 owner 篩選。
// 原操作已成功但較新操作又改變狀態時，receipt 與目前 trip/reservation 分開讀取。
// 只刪 live application 旅行與圖，不宣稱安全覆寫 WAL、備份或已下載副本。
