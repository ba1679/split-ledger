# Local environment and credentials
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Dependencies, builds, and local caches
node_modules/
.pnpm-store/
dist/
build/
.vite/
.cache/
*.tsbuildinfo

# Test results and tool logs
coverage/
playwright-report/
test-results/
*.log

# Generated validation evidence for all plans (keep scripts and summaries tracked)
/specs/plans/*/checks/T[0-9]*.json
/specs/plans/*/checks/T[0-9]*.txt
/specs/plans/*/checks/T[0-9]*.md
/specs/plans/*/checks/T[0-9]*.tar.gz
/specs/plans/*/checks/screens/
/specs/plans/*/checks/source-versions/

# Operating system files
.DS_Store
._*
Thumbs.db

# Generated executable Gherkin tests
.features-gen/

# Deployment backup artifacts
backups/
*.dump

# Python tool caches
__pycache__/
*.py[cod]
