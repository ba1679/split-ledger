{
  "name": "split-ledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:api": "bddgen -c apps/api/playwright.config.ts && playwright test -c apps/api/playwright.config.ts",
    "test:web": "bddgen -c apps/web/playwright.config.ts && playwright test -c apps/web/playwright.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:support": "playwright test -c playwright.support.config.ts",
    "test:web-support": "playwright test -c playwright.web-support.config.ts",
    "test:ui-quality": "playwright test -c playwright.ui-quality.config.ts",
    "test:deployment": "playwright test -c playwright.deployment.config.ts",
    "start": "pnpm --filter @split-ledger/api start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.10",
    "railway": "3.16.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
